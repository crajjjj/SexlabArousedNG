{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
    "name": "commonlibsse-sample-plugin",
    "version-string": "1.0.0",
    "port-version": 0,
    "description": "Sample SKSE plugin based on CommonLibSSE, for unified AE/SE/VR deployment.",
    "homepage": "https://www.skyrimng.com",
    "license": "Apache-2.0",
    "features": {
        "scripts": {
            "description": "Install Papyrus sources for this program to develop on top of it."
        },
        "scripts-dev": {
            "description": "Install Papyrus sources necessary to develop scripts for this plugin.",
            "dependencies": [
                "bethesda-skyrim-scripts",
                {
                    "name": "skse",
                    "default-features": false,
                    "features": [
                        "scripts"
                    ]
                }
            ]
        },
        "plugin": {
            "description": "Build the SKSE plugin. CommonLibSSE-NG itself is vendored as a git submodule (lib/commonlibsse-ng); these are its build dependencies.",
            "dependencies": [
                {
                    "name": "directxtk",
                    "version>=": "2025-10-27"
                },
                {
                    "name": "rapidcsv",
                    "version>=": "8.90"
                },
                {
                    "name": "spdlog",
                    "version>=": "1.16.0"
                }
            ]
        },
        "tests": {
            "description": "Build tests for the SKSE plugin.",
            "dependencies": [
                {
                    "name": "commonlibsse-sample-plugin",
                    "default-features": false,
                    "features": [
                        "plugin"
                    ]
                },
                "catch2"
            ]
        }
    },
    "default-features": [
        "scripts-dev",
        "plugin",
        "tests"
    ]
}
